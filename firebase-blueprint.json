{
  "entities": {
    "analysis": {
      "title": "Analysis",
      "description": "Minimal risk assessment result generated by TRUSTRA safety pipeline",
      "type": "object",
      "properties": {
        "analysisId": {
          "type": "string",
          "description": "Unique audit ID for the analysis",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when analysis was conducted"
        },
        "inputType": {
          "type": "string",
          "enum": ["text", "image", "voice"],
          "description": "Input modality"
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi", "or"],
          "description": "Language of analysis"
        },
        "riskLevel": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"],
          "description": "Calculated safety risk level"
        },
        "riskScore": {
          "type": "number",
          "description": "Calculated risk score between 0 and 100"
        },
        "confidence": {
          "type": "number",
          "description": "Confidence assessment between 0 and 1"
        },
        "summary": {
          "type": "string",
          "description": "Executive summary of safety analysis",
          "maxLength": 2048
        },
        "signals": {
          "type": "array",
          "description": "Discrete deception signals detected"
        },
        "claims": {
          "type": "array",
          "description": "Claims extracted from communication"
        },
        "evidenceStatus": {
          "type": "string",
          "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "INSUFFICIENT_EVIDENCE"],
          "description": "Evidence substantiation status"
        },
        "simpleExplanation": {
          "type": "string",
          "description": "Plain-language explanation for first-time or elderly investors",
          "maxLength": 2048
        },
        "safeActions": {
          "type": "array",
          "description": "List of recommended non-coercive safe actions"
        }
      },
      "required": [
        "analysisId",
        "createdAt",
        "inputType",
        "language",
        "riskLevel",
        "riskScore",
        "confidence",
        "evidenceStatus",
        "simpleExplanation"
      ]
    },
    "verification_result": {
      "title": "VerificationResult",
      "description": "Factual verification check record for a specific claim",
      "type": "object",
      "properties": {
        "analysisId": {
          "type": "string",
          "description": "Associated analysis audit ID",
          "maxLength": 64
        },
        "claim": {
          "type": "string",
          "description": "Target claim text checked against registry",
          "maxLength": 512
        },
        "status": {
          "type": "string",
          "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONTRADICTED", "INSUFFICIENT_EVIDENCE"],
          "description": "Directory cross-reference outcome"
        },
        "explanation": {
          "type": "string",
          "description": "Reasoning based on regulatory registers",
          "maxLength": 1024
        },
        "sources": {
          "type": "array",
          "description": "Official registry citations or directory URLs"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of verification"
        }
      },
      "required": ["analysisId", "claim", "status", "explanation", "createdAt"]
    },
    "session": {
      "title": "Session",
      "description": "Anonymous session activity record for abuse mitigation",
      "type": "object",
      "properties": {
        "lastActive": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity timestamp"
        },
        "requestCount": {
          "type": "number",
          "description": "Number of requests processed in session"
        }
      },
      "required": ["lastActive"]
    }
  },
  "firestore": {
    "/analyses/{analysisId}": {
      "schema": {
        "$ref": "#/entities/analysis"
      },
      "description": "Minimal risk assessment records"
    },
    "/verification_results/{resultId}": {
      "schema": {
        "$ref": "#/entities/verification_result"
      },
      "description": "Factual claim verification records"
    },
    "/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/session"
      },
      "description": "Anonymous session metadata"
    }
  }
}
